rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'bio', 'avatarUrl', 'phone', 'status', 'updatedAt']);
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Post owner editing caption/tags
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'tags', 'updatedAt'])) ||
        // Interaction counters update
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Subcollection: Likes
      match /likes/{likeId} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      }

      // Subcollection: Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Direct Messages & Conversations
    match /conversations/{conversationId} {
      allow read, write: if isSignedIn() && (
        resource.data.participantOne == request.auth.uid ||
        resource.data.participantTwo == request.auth.uid
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
