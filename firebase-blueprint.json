{
  "entities": {
    "User": {
      "title": "User",
      "description": "Spotlight user profile entity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "username": { "type": "string", "maxLength": 30, "pattern": "^[a-zA-Z0-9_.]+$" },
        "fullName": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 25 },
        "status": { "type": "string", "enum": ["online", "offline", "away"] },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "fullName", "email"]
    },
    "Post": {
      "title": "Post",
      "description": "Standard feed photo/video post or vertical Spotlight reel",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["standard", "spotlight_reel"] },
        "mediaUrl": { "type": "string", "maxLength": 2048 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "caption": { "type": "string", "maxLength": 2200 },
        "tags": { "type": "array" },
        "audioTrackTitle": { "type": "string", "maxLength": 120 },
        "audioTrackArtist": { "type": "string", "maxLength": 120 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "aspectRatio": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "mediaUrl"]
    },
    "Like": {
      "title": "Like",
      "description": "User like relationship on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "postId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment in message stream",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 1000 },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "userId", "content"]
    },
    "Message": {
      "title": "Message",
      "description": "Direct message between users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "maxLength": 2048 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "senderId", "recipientId", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Collection of feed posts and vertical spotlight reels"
    },
    "/posts/{postId}/likes/{likeId}": {
      "schema": "Like",
      "description": "Likes subcollection for a post"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments stream for a post"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Direct message thread for conversational participants"
    }
  }
}
